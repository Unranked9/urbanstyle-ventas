<nav class="sidebar" id="sidebar">
	<div class="sidebar-brand">
		<div class="d-flex align-items-center gap-2">
			<i class="bi bi-bag-heart-fill fs-4" style="color: var(--accent)"></i>
			<div>
				<div class="brand-title">URBANSTYLE</div>
				<div class="brand-sub">Sistema de ventas</div>
			</div>
		</div>
	</div>

	<div class="sidebar-user">
		<div class="avatar-circle"><c:out value="${us.iniciales}" /></div>
		<div style="min-width: 0">
			<div class="fw-semibold text-truncate" style="font-size: 0.85rem">
				<c:out value="${us.nombreCompleto}" />
			</div>
			<span class="badge ${us.admin ? 'badge-rol' : 'bg-secondary'}" style="font-size: 0.65rem">
				<c:out value="${us.rolEtiqueta}" />
			</span>
		</div>
	</div>

	<div class="sidebar-nav">
		<a href="${ctx}/dashboard" class="nav-link ${paginaActual == 'dashboard' ? 'active' : ''}">
			<i class="bi bi-speedometer2"></i> Dashboard
		</a>

		<div class="nav-section">Ventas</div>
		<a href="${ctx}/ventas/nueva" class="nav-link ${paginaActual == 'nuevaVenta' ? 'active' : ''}">
			<i class="bi bi-cart-plus"></i> Nueva venta
		</a>
		<a href="${ctx}/historial" class="nav-link ${paginaActual == 'historial' ? 'active' : ''}">
			<i class="bi bi-receipt"></i> Historial de ventas
		</a>
		<a href="${ctx}/clientes" class="nav-link ${paginaActual == 'clientes' ? 'active' : ''}">
			<i class="bi bi-person-vcard"></i> Clientes
		</a>

		<div class="nav-section">Inventario</div>
		<a href="${ctx}/productos" class="nav-link ${paginaActual == 'productos' ? 'active' : ''}">
			<i class="bi bi-box-seam"></i> Productos
		</a>
		<c:if test="${us.gestor}">
			<a href="${ctx}/catalogos" class="nav-link ${paginaActual == 'catalogos' ? 'active' : ''}">
				<i class="bi bi-tags"></i> Catálogos
			</a>
		</c:if>

		<div class="nav-section">Cuenta</div>
		<c:if test="${us.admin}">
			<a href="${ctx}/usuarios" class="nav-link ${paginaActual == 'usuarios' ? 'active' : ''}">
				<i class="bi bi-people-fill"></i> Usuarios
			</a>
		</c:if>
		<a href="${ctx}/perfil" class="nav-link ${paginaActual == 'perfil' ? 'active' : ''}">
			<i class="bi bi-person-circle"></i> Mi perfil
		</a>
	</div>

	<div class="sidebar-footer">
		<a href="${ctx}/logout" class="nav-link text-danger px-0">
			<i class="bi bi-box-arrow-left"></i> Cerrar sesión
		</a>
	</div>
</nav>
